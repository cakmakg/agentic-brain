# Abhängigkeiten
node_modules/

# Umgebung & Geheimnisse
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Betriebssystem / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build-Ausgabe
dist/
build/

# Claude Code — lokale Berechtigungen. Nicht auf die globale Ignore-Regel verlassen:
# das Repo muss für sich allein ausreichen, sonst leckt die Datei bei jedem Klon.
.claude/settings.local.json

# Projektgedächtnis — die Sitzungsbrücke bleibt lokal,
# die Entscheidungs- und Regelschicht wird committet.
.gehirn/letzte-sitzung.md

# Traces — je Lauf eine JSONL-Datei. Lokal das Werkzeug zur Ursachensuche,
# im Repo Ballast. Committet wird nur, was als Beispiel dient.
evals/traces/*
!evals/traces/samples/

# Messberichte entstehen aus einem datierten Lauf. Welche davon als Beleg ins
# Repo gehören, ist eine bewusste Entscheidung — nicht ein Nebenprodukt.
evals/reports/*
!evals/reports/.gitkeep
# Diese beiden trägt PRODUCT.md §6 als Beleg — ein Dokument, das sich auf einen
# Bericht beruft, den es im Repo nicht gibt, hat keine Belege, sondern Zahlen.
# Den Namen baut evals/runners/policy.js:567 zusammen:
#   <datum>-schicht-a-<domäne>-<STORE_ADAPTER>-<EMBEDDING_ADAPTER>.json
# Bis 2026-09-16 stand hier dreimal ein Name OHNE Adaptersuffix. Keiner traf eine
# Datei, git check-ignore meldete IGNORIERT — zu keiner Zahl aus §6 lag ein Beleg
# im Repo. Eine Ausnahme, die danebengreift, bricht nichts und ist deshalb blind.
!evals/reports/2026-09-10-schicht-a-beispiel-memory-hash.json
!evals/reports/2026-09-10-schicht-a-besprechung-memory-hash.json
# Die vier vom 2026-09-16 belegen ADR-0013: beide Adapter, dieselbe Suite, am
# selben Tag. Erst dieses Paar macht die Aussage „dieselben Zahlen" prüfbar —
# zwei Berichte von verschiedenen Tagen hätten sie nur behauptet. Für den
# Postgres-Lauf vom 2026-09-10 steht weiterhin KEINE Zeile: er hat nie einen
# Bericht erzeugt, und der Dateiname trägt die Laufzeit — nachträglich belegen
# lässt sich diese Zeile deshalb nicht (EVALS.md §8).
!evals/reports/2026-09-16-schicht-a-beispiel-memory-hash.json
!evals/reports/2026-09-16-schicht-a-beispiel-postgres-hash.json
!evals/reports/2026-09-16-schicht-a-besprechung-memory-hash.json
!evals/reports/2026-09-16-schicht-a-besprechung-postgres-hash.json
!evals/reports/2026-09-20-schicht-a-beispiel-memory-hash.json
!evals/reports/2026-09-20-schicht-a-beispiel-postgres-hash.json
!evals/reports/2026-09-20-schicht-a-besprechung-memory-hash.json
!evals/reports/2026-09-20-schicht-a-besprechung-postgres-hash.json

# Dauerhafter Zustand: Checkpoints, Artefakte, Aktionsqueue. Laufzeitdaten eines
# konkreten Rechners — im Repo hätten sie nichts zu suchen. Der Ort ist über
# STATE_DIR überschreibbar; Tests und Harness zeigen auf ein Temp-Verzeichnis.
.zustand/

# Wissensgraph (graphify). Erzeugte Ausgabe eines Laufs, kein Vertrag: Graph,
# HTML und Bericht entstehen jederzeit neu aus dem Korpus. Im Repo würden sie
# bei jeder Änderung als Diff-Lärm auftauchen, ohne eine Zusage zu tragen.
graphify-out/

# Fremde Planungstexte und Arbeitsmaterial. Vorschlag, keine Quelle: was daraus
# uebernommen wurde, steht in docs/roadmap.md §8 — mit Begruendung, wo dieser
# Plan abweicht. Der Ausgangstext selbst ist nicht Teil dieses Repos.
data/
