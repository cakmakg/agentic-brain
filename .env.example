# ── agentic-brain · Umgebungsvariablen ──────────────────────────────────────
# Kopieren nach `.env`. Die echte `.env` gehört NIE ins Repo (.gitignore).
# Gelesen wird ausschliesslich in src/kernel/config/env.js — greif nirgends
# sonst auf process.env zu, sonst gibt es auf die Frage "welche Variablen gibt
# es?" mehr als eine Antwort.

# LLM-Schluessel. LEER LASSEN = MOCK-MODUS: der komplette Ablauf laeuft Ende zu
# Ende ohne Netz, ohne Kosten, deterministisch. Tests und die Evaluationen der
# Schicht A setzen das voraus und brechen ab, wenn hier ein Schluessel steht.
ANTHROPIC_API_KEY=

# Standardmodell. Pro Rolle ueberschreibbar: MODEL_<ROLLE> in Grossbuchstaben,
# z. B. MODEL_ORCHESTRATOR=claude-haiku-4-5 fuer einen billigeren Router.
MODEL=claude-sonnet-4-6

# API-Schluessel der HTTP-Schicht. Wird GEPRUEFT, nicht bereinigt.
API_KEY=dev-local-key

# Monatliches Budget in USD. Ist es ueberschritten, bricht der Guardrail ab,
# BEVOR ein einziger LLM-Aufruf entsteht (Kill-Switch).
MONTHLY_BUDGET_USD=5

# HTTP-Port.
PORT=3000

# Mandant. Heute genau einer — aber jede Lesung filtert danach. Eine Abfrage
# ohne Mandantenfilter gilt als Defekt, auch solange es nur einen gibt.
TENANT_ID=default

# Wohin der dauerhafte Zustand geschrieben wird (Checkpoints, Artefakte,
# Aktionsqueue). Tests und Harness zeigen hier auf ein Temp-Verzeichnis.
STATE_DIR=

# Wohin die Traces geschrieben werden. Standard: evals/traces
TRACE_DIR=
