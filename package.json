{
  "name": "agentic-brain",
  "version": "0.1.0",
  "description": "Permission-aware Enterprise Context Layer mit agentischer Prozessautomatisierung.",
  "private": true,
  "type": "module",
  "main": "src/bin/serve.js",
  "scripts": {
    "start": "node src/bin/serve.js",
    "dev": "node --watch src/bin/serve.js",
    "demo": "node src/bin/demo.js",
    "test": "node --test --test-force-exit --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=src/adapters/http/server.js --test-coverage-exclude=src/bin/*.js \"tests/**/*.test.js\"",
    "evals": "node evals/runners/policy.js"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.9",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "@langchain/core": "1.2.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "lefthook": "2.1.12",
    "prettier": "3.9.6"
  }
}
